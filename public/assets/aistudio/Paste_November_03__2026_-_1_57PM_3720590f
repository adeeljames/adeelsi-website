/* hero mock timeline */
(function(){
  const r1=$('#r1'), r2=$('#r2'), rep=$('#rep'), typed=$('#typed'), caret=$('#caret'), s1=$('#s1'), s2=$('#s2'), s3=$('#s3'), apw=$('#apw'), appr=$('#appr'), cAns=$('#cAns'), cWait=$('#cWait');
  const text = 'Hi Sara, delivery to Lahore takes 2-3 working days after dispatch. Regards, Support Team';
  const T = [];
  const at = (ms, fn) => T.push(setTimeout(fn, ms));
  function reset(){ T.splice(0).forEach(clearTimeout); [r1,r2,rep,s1,s2,s3,apw].forEach(e => e.classList.remove('show')); typed.textContent=''; caret.style.display='inline-block'; appr.classList.remove('press'); cAns.textContent='1'; cWait.innerHTML='<b class="num">1</b> waiting for you'; s2.style.display=''; }
