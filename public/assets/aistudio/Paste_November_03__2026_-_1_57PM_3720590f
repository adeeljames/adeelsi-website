  if(reduced){ final(); return; }
  function run(){
    reset();
    at(500, () => r1.classList.add('show'));
    at(1200, () => rep.classList.add('show'));
    for(let i=0;i<text.length;i++) at(1400 + i*28, () => { typed.textContent = text.slice(0,i+1); });
    const t1 = 1400 + text.length*28;
    at(t1+200, () => { caret.style.display='none'; s1.classList.add('show'); });
    at(t1+1200, () => { r2.classList.add('show'); s2.classList.add('show'); cAns.textContent='1'; });
    at(t1+2400, () => apw.classList.add('show'));
    at(t1+3600, () => appr.classList.add('press'));
    at(t1+4000, () => { s2.classList.remove('show'); s2.style.display='none'; apw.classList.remove('show'); s3.classList.add('show'); cAns.textContent='2'; cWait.innerHTML='<b class="num">0</b> waiting for you'; });
    at(t1+7000, () => $('#mock').classList.add('out'));
    at(t1+7800, () => { $('#mock').classList.remove('out'); run(); });
  }
  const mo = new IntersectionObserver(es => { es.forEach(e => { if(e.isIntersecting){ if(!run.on){ run.on = true; run(); } } else { run.on = false; T.splice(0).forEach(clearTimeout); } }); }, {threshold:.25});
  mo.observe($('#mock'));
})();

