    e.preventDefault();
    const data = new FormData(form); if(data.get('bot-field')) return;
    const msg = `Hi Adeel, I'd like an AI email agent set up.\nName: ${data.get('name')}\nEmail: ${data.get('email')}\nBusiness: ${data.get('business')}\nEmails per day: ${data.get('volume')}\nCustomers ask most: ${data.get('questions') || '-'}`;
    btn.disabled = true;
    let ok = false;
    try { const res = await fetch('/', {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:new URLSearchParams(data).toString()}); ok = res.ok && location.protocol.startsWith('http'); } catch(_){}
    form.classList.add('hide'); thanks.classList.add('show');
    if(ok){ $('#thTitle').textContent = 'Thank you, ' + (data.get('name') || '').split(' ')[0] + '.'; $('#thText').textContent = "I've got your request and I'll reply with a quote and a plan."; }
    else {
      try { await navigator.clipboard.writeText(msg); } catch(_){}
      $('#thTitle').textContent = 'One last step.';
      $('#thText').textContent = CONFIG.EMAIL ? 'Your request is ready. Send it by email, or paste it into a LinkedIn message.' : 'Your request is copied. Paste it into a LinkedIn message and I\'ll reply with a quote.';
      $('#thBtn').hidden = false;
      if(CONFIG.EMAIL){ window.location.href = 'mailto:' + CONFIG.EMAIL + '?subject=' + encodeURIComponent('AI email agent setup') + '&body=' + encodeURIComponent(msg); }
    }
  });
})();

/* sticky cta (mobile) */
(function(){
  const st = $('#sticky');
  function upd(){ const home = !document.body.classList.contains('about'); const y = scrollY, start = $('#start'); const sr = start ? start.getBoundingClientRect() : {top:1e9}; st.classList.toggle('on', home && y > innerHeight*.8 && sr.top > innerHeight*.7); }
  addEventListener('scroll', upd, {passive:true}); addEventListener('resize', upd); upd();
})();

fromHash();
