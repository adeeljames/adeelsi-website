  .roads .road{min-height:0}.road h3{margin-top:30px}
  .step,.step+.step{padding:26px 0;border-left:0;border-top:1px solid rgb(var(--ink)/.14)}.steps{border-top:0}.step:first-child{border-top:0}
  .offer{grid-template-columns:1fr}.fcard{grid-template-columns:1fr}
