  .lede{font-size:17px}
  .dark{margin:0 8px;border-radius:30px}.vframe{border-radius:22px;margin-top:34px}.play{width:72px;height:72px}
  .ocard ul{grid-template-columns:1fr}.f2{grid-template-columns:1fr}
  .teaser{grid-template-columns:1fr;border-radius:32px}.teaser img{width:130px}
  .fcard{border-radius:32px;padding:28px 22px}
  .sticky{display:flex;position:fixed;left:12px;right:12px;bottom:calc(12px + var(--safe-b));z-index:80;height:62px;border-radius:999px;padding:6px 6px 6px 22px;align-items:center;justify-content:space-between;gap:10px;background:rgba(17,17,17,.94);color:#F7F5F0;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);transform:translateY(120%);transition:transform .5s var(--ease);font-size:15px;font-weight:500}
  .sticky.on{transform:none}
  .sticky a{height:48px;padding:0 20px;border-radius:999px;background:#F7F5F0;color:#111;display:flex;align-items:center;font-weight:500;text-decoration:none;font-size:14.5px}
  footer{padding-bottom:calc(96px + var(--safe-b))}
  .road h3{font-size:34px}.road{padding:26px 22px}
  .feat{padding:26px 22px}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-delay:0s!important;animation-iteration-count:1!important;transition-duration:.01ms!important;transition-delay:0s!important}
  .js .reveal,.js .rvh{opacity:1;transform:none;filter:none}
}
</style>
